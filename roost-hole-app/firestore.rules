rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The one shared owner account. All owners sign in to it with the owner code.
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'owner@theroostholeguideservice.com';
    }
    // Hunt calendar: anyone can read, only owners can change it.
    match /public/{doc} {
      allow read: if true;
      allow write: if isOwner();
    }
    // Duck Club: readable only by someone who knows the club code. Nobody can list the codes.
    match /clubs/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isOwner();
    }
    // The current club code: owners only.
    match /owner/{doc} {
      allow read, write: if isOwner();
    }
  }
}
